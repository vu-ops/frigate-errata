# Credentials for Frigate's built-in authentication (only needed if you
# enabled auth in Frigate 0.16+). Leave empty if your Frigate has no auth.
# Create a dedicated Frigate user for errata (Admin > Users or setup wizard).
ERRATA_FRIGATE_USER=
ERRATA_FRIGATE_PASSWORD=

# OpenRouter API key for the review queue's "GenAI Help" button. Leave empty to
# disable the feature. Never committed; referenced by settings.yaml as
# ${OPENROUTER_API_KEY:-}.
OPENROUTER_API_KEY=
